{
  "name": "SunSide - Sitzseite fuer Sonne und Schatten",
  "short_name": "SunSide",
  "id": "/",
  "description": "Sag mir, auf welcher Seite ich im Zug, Bus oder Flugzeug sitzen soll, damit ich im Schatten (oder in der Sonne) sitze. Offline-faehig, ohne Tracking.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f6f8",
  "theme_color": "#f2b705",
  "lang": "de",
  "dir": "ltr",
  "categories": ["travel", "navigation", "utilities", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "handle_links": "preferred",
  "icons": [
    { "src": "assets/icon-192.png",      "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png",      "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icon.svg",          "sizes": "any",     "type": "image/svg+xml", "purpose": "any" },
    { "src": "assets/icon-maskable.svg", "sizes": "any",     "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "assets/screenshot-narrow.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "SunSide Empfehlung mit Karte und Segmenten"
    },
    {
      "src": "assets/screenshot-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "SunSide Workbench mit Konfiguration und Routenkarte"
    }
  ],
  "shortcuts": [
    {
      "name": "Schatten finden",
      "short_name": "Schatten",
      "description": "Direkt mit Praeferenz Schatten starten.",
      "url": "./?pref=Schatten&source=shortcut",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Sonne finden",
      "short_name": "Sonne",
      "description": "Direkt mit Praeferenz Sonne starten.",
      "url": "./?pref=Sonne&source=shortcut",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
